# Local demo only. Use URL-safe alphanumeric credentials in connection URLs.
AIRFLOW_UID=50000
POSTGRES_PASSWORD=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_WEB_PORT=8080
POSTGRES_PORT=5432
AIRFLOW_LOG_DIR=./logs
# Set generated keys before sharing a deployment beyond your own machine.
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=local-eurostat-demo-change-before-sharing

# Optional Claude reports. Keep the real key only in your ignored .env file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ENABLE_AI_INSIGHTS=true
